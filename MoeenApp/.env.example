# Native app API. Use a device-reachable address during local development.
EXPO_PUBLIC_API_URL=http://192.168.1.12:3000

# Public HTTPS origin serving the exported/web responder page at /e.
EXPO_PUBLIC_EMERGENCY_RESPONDER_BASE_URL=https://responder.example.com

# Public HTTPS API origin used by the responder page. For the documented
# same-origin development proxy, this is the same value as the responder URL.
EXPO_PUBLIC_EMERGENCY_RESPONDER_API_BASE_URL=https://responder.example.com
