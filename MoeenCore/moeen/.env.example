DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/your_postgres_db
CLINICAL_TABLES_BASE_URL=https://clinicaltables.nlm.nih.gov
SNOMED_FHIR_BASE_URL=https://r4.ontoserver.csiro.au/fhir

REDIS_HOST=localhost
REDIS_PORT=6379

# Operational HTTP surfaces are disabled by default, and both authenticate with
# HTTP Basic, so both must run behind HTTPS. Enabling either without its
# credentials fails at startup rather than publishing the surface.
SWAGGER_ENABLED=false
SWAGGER_USERNAME=
# Minimum 16 characters; use only over HTTPS.
SWAGGER_PASSWORD=
QUEUE_DASHBOARD_ENABLED=false
QUEUE_DASHBOARD_USERNAME=
# Minimum 16 characters; use only over HTTPS.
QUEUE_DASHBOARD_PASSWORD=

# Comma-separated exact origins. Leave empty when browser cross-origin access
# is not needed; wildcard origins are rejected at startup.
CORS_ORIGINS=

# Must match the Firebase project the frontend authenticates against (see MoeenApp/src/firebase/config.ts),
# otherwise firebase-admin cannot resolve a project ID and verifyIdToken() fails for every request.
FIREBASE_PROJECT_ID=your_firebase_project_id
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov
RXNORM_TIMEOUT_MS=8000

DDINTER_DATA_DIR=data/ddinter

# Microsoft Foundry (Azure AI Services) — GN-2 provider gateway.
# GENERATION_PROVIDER=stub (the default) runs the whole guidance pipeline with
# no Foundry account, no key, no network and no cost. See
# src/guidance/generation/provider-gateway/README.md for every generation key.
GENERATION_PROVIDER=stub
FOUNDRY_ENDPOINT=https://your-resource.cognitiveservices.azure.com
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=gpt-5.4-mini
FOUNDRY_API_VERSION=2024-12-01-preview
PRESCRIPTION_SCAN_MAX_FILE_SIZE_BYTES=10485760
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_MS=30000
EMERGENCY_PUBLIC_RATE_LIMIT=30
EMERGENCY_PUBLIC_RATE_WINDOW_MS=60000
# Set only to the exact number of trusted reverse-proxy hops. Default: 0.
TRUST_PROXY_HOPS=0
EMERGENCY_PUBLIC_RATE_LIMIT=30
EMERGENCY_PUBLIC_RATE_WINDOW_MS=60000
# Set only to the exact number of trusted reverse-proxy hops. Default: 0.
TRUST_PROXY_HOPS=0
# HTTPS origin serving the public /e responder page. Leave empty for same-origin.
EMERGENCY_RESPONDER_ORIGIN=

# Twilio — outbound SMS for emergency-contact safety alerts. Unset in dev/CI:
# TwilioSmsAdapter returns a NotConfigured error result instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
